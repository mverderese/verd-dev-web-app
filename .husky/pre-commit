# Remember what was staged, format and check, then re-stage only those files
# so formatting fixes are included without sweeping in unrelated changes.
staged=$(git diff --cached --name-only --diff-filter=ACMR)

npm run prettify
npm run lint
npm test

if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | while IFS= read -r file; do
    git add -- "$file"
  done
fi
