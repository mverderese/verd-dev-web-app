{
  "name": "verd-dev-web-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "node scripts/serve-static.mjs",
    "typecheck": "react-router typegen && tsc",
    "lint": "concurrently --names prettier,eslint,tsc \"prettier --check .\" \"eslint .\" \"npm run typecheck\"",
    "prettify": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "git:install-hooks": "husky",
    "terraform:bootstrap": "terraform -chdir=ops/terraform/bootstrap init && terraform -chdir=ops/terraform/bootstrap apply",
    "terraform:plan": "terraform -chdir=ops/terraform init && terraform -chdir=ops/terraform plan",
    "terraform:apply": "terraform -chdir=ops/terraform init && terraform -chdir=ops/terraform apply"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@react-router/node": "7.18.4",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "9.2.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
